# Copie para .env (opcional). Sem .env, o docker compose usa os valores padrão abaixo.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# fake = funciona sem chave | groq = usa a API da Groq (crie a chave em https://console.groq.com/keys)
AI_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
